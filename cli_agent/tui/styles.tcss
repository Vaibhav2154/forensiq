/*
 * ForensIQ TUI - semantic stylesheet.
 *
 * Colours are NOT defined here. Every colour resolves from the active
 * Textual theme via the `fq-*` variables declared in theme.py:
 *
 *   $fq-canvas      main background            $fq-surface   cards/panels/stream
 *   $fq-chrome      header/footer              $fq-sidebar   navigation column
 *   $fq-border      thin sage/theme border     $fq-heading   panel headings
 *   $fq-text        body text                  $fq-muted     secondary text
 *   $fq-ok/warning/error/info                  status colours
 *   $fq-nav-selected(-text)                    active navigation item
 *   $fq-row-alt / $fq-cursor-*                 DataTable rows and selection
 *   $fq-button-*                               buttons in every state
 *   $fq-scrollbar-*                            scrollbars
 *
 * Because the values come from the theme, switching themes (Ctrl+P ->
 * "Change the current theme") repaints the entire application without a
 * restart. Layout, spacing, borders, widget positions, navigation and
 * shortcuts below are unchanged from the approved interface.
 */

Screen {
    background: $fq-canvas;
    color: $fq-text;
}

Header {
    background: $fq-chrome;
    color: $fq-header-text;
}

Header > .header--highlight {
    color: $fq-heading;
    text-style: bold;
}

Footer {
    background: $fq-chrome;
    color: $fq-text;
}

FooterKey {
    background: $fq-chrome;
}

FooterKey .footer-key--key {
    color: $fq-footer-key;
    background: $fq-chrome;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: $fq-footer-desc;
    background: $fq-chrome;
}

FooterKey:hover {
    background: $fq-button-hover-bg;
    color: $fq-text;
}

#body { height: 1fr; }

#sidebar {
    width: 28;
    background: $fq-sidebar;
    border-right: solid $fq-border;
    padding: 1 0;
}

#brand {
    padding: 0 2;
    color: $fq-heading;
    text-style: bold;
}

#brand-sub {
    padding: 0 2 1 2;
    color: $fq-muted;
}

ListView { background: $fq-sidebar; }

ListItem {
    padding: 0 1;
    color: $fq-text;
    background: $fq-sidebar;
}

/* Selected sidebar destination: blue fill, contrasting text. */
ListView > ListItem.-highlight,
ListView:focus > ListItem.-highlight {
    background: $fq-nav-selected !important;
    color: $fq-nav-selected-text !important;
    text-style: bold;
}

#main { padding: 1 2; }

.card {
    width: 1fr;
    height: 5;
    border: round $fq-border;
    background: $fq-surface;
    color: $fq-text;
    padding: 0 1;
    margin-right: 1;
}

.card-title { color: $fq-muted; }
.card-value { color: $fq-text; text-style: bold; }

.ok { color: $fq-ok; }
.warn { color: $fq-warning; }
.bad { color: $fq-error; }
.info { color: $fq-info; }

#panels { height: 1fr; }

#monitor-panel {
    width: 44;
    border: round $fq-border;
    background: $fq-surface;
    padding: 1;
    margin-right: 1;
}

#technique-panel {
    width: 1fr;
    border: round $fq-border;
    background: $fq-surface;
    padding: 1;
}

.panel-title {
    color: $fq-heading;
    text-style: bold;
}

.kv { color: $fq-muted; }

#controls { height: 3; margin-top: 1; }

/* Textual buttons have a 16-cell minimum width, which clipped the third
 * control ("Force cycle") inside the fixed 44-cell monitor panel. Allow the
 * labels to size themselves; geometry of every other button is unaffected. */
#controls Button { min-width: 10; }

/* Buttons stay neutral in every state. Palette roles are still available to
 * the widgets (success/error variants), but the visible colours follow the
 * active theme rather than Textual's solid variant fills. */
Button {
    margin-right: 1;
    background: $fq-button-bg !important;
    color: $fq-button-text !important;
    border: tall $fq-border !important;
}

Button:hover {
    background: $fq-button-hover-bg !important;
    color: $fq-button-text !important;
    border: tall $fq-border !important;
}

Button:focus {
    background: $fq-button-bg !important;
    color: $fq-button-text !important;
    border: tall $fq-button-focus-border !important;
}

Button.-active {
    background: $fq-button-active-bg !important;
    border: tall $fq-border !important;
}

Button:disabled,
Button.-disabled {
    color: $fq-button-disabled-text !important;
    background: $fq-button-bg !important;
    border: tall $fq-button-disabled-border !important;
}

#stream-panel {
    height: 12;
    border: round $fq-border;
    background: $fq-surface;
    padding: 0 1;
    margin-top: 1;
}

#view-note {
    color: $fq-muted;
    padding: 0 0 1 0;
}

DataTable {
    background: $fq-surface;
    color: $fq-text;
}

/* Textual tints focused tables with the foreground; never tint the surface. */
DataTable:focus {
    background-tint: $fq-surface 0%;
}

DataTable > .datatable--header,
DataTable:focus > .datatable--header {
    background: $fq-surface !important;
    background-tint: $fq-surface 0% !important;
    color: $fq-heading !important;
    text-style: bold;
}

/* Blurred cursor: subtle, neutral. */
DataTable > .datatable--cursor {
    background: $fq-cursor-blurred-bg !important;
    color: $fq-cursor-blurred-text !important;
}

/* Actively selected row: restrained teal from the active theme. */
DataTable:focus > .datatable--cursor {
    background: $fq-cursor-bg !important;
    color: $fq-cursor-text !important;
}

DataTable > .datatable--even-row { background: $fq-surface; }
DataTable > .datatable--odd-row { background: $fq-row-alt; }
DataTable > .datatable--hover { background: $fq-button-hover-bg; }
DataTable > .datatable--header-cursor {
    background: $fq-button-hover-bg;
    color: $fq-heading;
}

RichLog {
    background: $fq-surface;
    color: $fq-text;
}

Input {
    background: $fq-surface;
    color: $fq-text;
    border: tall $fq-border;
}

Input:focus {
    border: tall $fq-button-focus-border;
}

Input > .input--placeholder {
    color: $fq-muted;
}

/* Sign-in modal. Added for authentication (Phase 4 + 5); the dashboard
 * layout underneath is unchanged. */
LoginScreen {
    align: center middle;
    background: $fq-overlay;
}

#login-box {
    width: 46;
    height: auto;
    border: round $fq-border;
    background: $fq-surface;
    padding: 1 2;
}

#login-box .kv { color: $fq-muted; padding: 1 0 0 0; }

#login-actions { height: 3; margin-top: 1; }

#login-error { color: $fq-error; height: 1; }

/* Phase 6: page content lives inside the approved regions. Sizes here are
 * content affordances only; the shell (sidebar, cards, panels, stream) keeps
 * the preview's dimensions. */
#page-detail {
    height: 1fr;
    margin-top: 1;
    scrollbar-size: 1 1;
}

.field-label {
    color: $fq-muted;
    padding: 1 0 0 0;
}

#settings-form { height: auto; }
#settings-form Input { width: 100%; }

#knowledge-form { height: 3; }
#knowledge-form Input { width: 1fr; }

#form-error {
    color: $fq-error;
    height: auto;
    padding: 1 0 0 0;
}

#detail-view {
    display: none;
    height: 1fr;
    background: $fq-surface;
    color: $fq-text;
    border-top: solid $fq-border;
    margin-top: 1;
}

Checkbox {
    background: $fq-surface;
    color: $fq-text;
    padding: 1 0 0 0;
}

Checkbox > .toggle--button {
    background: $fq-nav-selected;
    color: $fq-nav-selected-text;
}

/* HITL Remediation view controls & confirmation modals (semantic variables only). */
#remediation-controls {
    display: none;
    height: auto;
    margin-top: 1;
}

#remediation-controls-row1,
#remediation-controls-row2 {
    height: 3;
    margin-top: 0;
}

#remediation-controls Button {
    min-width: 12;
}

RemediationConfirmScreen,
RollbackConfirmScreen,
RejectReasonScreen {
    align: center middle;
    background: $fq-overlay;
}

#remediation-modal-box {
    width: 78;
    max-height: 34;
    height: auto;
    border: round $fq-border;
    background: $fq-surface;
    padding: 1 2;
}

#remediation-reject-box {
    width: 58;
    height: auto;
    border: round $fq-border;
    background: $fq-surface;
    padding: 1 2;
}

#remediation-preview-scroll {
    height: 12;
    margin-top: 1;
    border: solid $fq-border-dim;
    background: $fq-surface;
    scrollbar-size: 1 1;
}

#remediation-preview-log {
    height: auto;
    background: $fq-surface;
    color: $fq-text;
}

#remediation-modal-actions {
    height: 3;
    margin-top: 1;
}
