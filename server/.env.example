# ForensIQ API Server Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000

# AI Services
GEMINI_API_KEY=your-gemini-api-key-here

# Multi-Agent Investigation (LangGraph + Gemini)
# Optional comma-separated pool of Gemini API keys distributed across sub-agents
# (falls back to GEMINI_API_KEY if omitted)
INVESTIGATION_GEMINI_API_KEYS=
# Optional per-agent Gemini API key overrides:
# INVESTIGATION_GEMINI_API_KEY_ORCHESTRATOR=
# INVESTIGATION_GEMINI_API_KEY_EVENT_ANALYST=
# INVESTIGATION_GEMINI_API_KEY_KNOWLEDGE_ENRICHER=
# INVESTIGATION_GEMINI_API_KEY_SEQUENCE_ANALYST=
# INVESTIGATION_GEMINI_API_KEY_CORRELATION_TIMELINE=
# INVESTIGATION_GEMINI_API_KEY_ATTACK_PATH=
# INVESTIGATION_GEMINI_API_KEY_RECOMMENDATION=
INVESTIGATION_GEMINI_MODEL=gemini-2.5-flash
INVESTIGATION_MAX_REFINEMENT_ROUNDS=1
INVESTIGATION_TEMPERATURE=0.1

# Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Logging
LOG_LEVEL=INFO

# Note: For Render deployment, PORT is automatically set by the platform